# =======================================================
# AI Student Helpdesk Assistant - Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =======================================================

# Port the Express server listens on (default: 5001)
PORT=5001

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helpdesk?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------
# Deployment-only settings (leave empty for local development)
# ---------------------------------------------------------------

# Comma-separated list of allowed frontend origins for CORS.
# Example (Render + Vercel): https://helpdesk.onrender.com,https://helpdesk.vercel.app
# Leave empty to allow all origins (safe only in local dev).
CLIENT_ORIGIN=

